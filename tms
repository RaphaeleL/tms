#!/usr/bin/env bash
# shellcheck shell=bash
set -uo pipefail

TMS_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tms"
TMS_CONFIG_FILE="${TMS_CONFIG_FILE:-$TMS_CONFIG_DIR/config}"
TMUX_SESSION_FILE="${TMUX_SESSION_FILE:-$TMS_CONFIG_DIR/sessions}"
TMS_DEFAULT_SEARCH_DEPTH="${TMS_DEFAULT_SEARCH_DEPTH:-1}"
TMS_GIT_STARTUP="${TMS_GIT_STARTUP:-}"
FULLSCREEN_FZF=0
FORCE=0
PROJECT_ARGUMENT=""

log() {
    [[ "${TMS_DEBUG:-0}" == 1 ]] && printf '[tms DEBUG] %s\n' "$*" >&2
}

say() { printf 'tms: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }

create_default_config() {
    [[ -e "$TMS_CONFIG_FILE" ]] && return
    mkdir -p "$TMS_CONFIG_DIR" || die "cannot create config directory: $TMS_CONFIG_DIR"
    chmod 700 "$TMS_CONFIG_DIR" 2>/dev/null || true
    umask 077
    cat > "$TMS_CONFIG_FILE" <<'EOF'
# tms configuration
#
# Directories are searched by `tms <project>` and shown by the FZF picker.
# Add as many entries as you like. Append :DEPTH to control search depth,
# for example: "$HOME/workspace:2".
TS_SEARCH_PATHS=(
    "$HOME/Desktop"
    "$HOME/workspace"
    "$HOME/workspace/ports"
    "$HOME/workspace/privates"
    "$HOME/workspace/images"
) 
# With `tms prepare` you are able to predefine certain Windows.
TMS_WINDOWS=(dev git build test llm)
EOF
    chmod 600 "$TMS_CONFIG_FILE" 2>/dev/null || true
    say "created config at $TMS_CONFIG_FILE"
}

load_config() {
    create_default_config
    source "$TMS_CONFIG_FILE"
}

require() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but was not found in PATH."; }
require_tmux() { require tmux; }
has_session() { tmux has-session -t "$1" 2>/dev/null; }
has_server() { tmux list-sessions >/dev/null 2>&1; }

window_index_by_name() {
    local d=$'\t'
    tmux list-windows -t "$1" -F "#I${d}#W" 2>/dev/null |
        awk -F '\t' -v name="$2" '$2 == name { print $1; exit }'
}
has_window() { [[ -n "$(window_index_by_name "$1" "$2")" ]]; }

ensure_private_parent() {
    mkdir -p "$(dirname "$TMUX_SESSION_FILE")" || die "cannot create state directory"
    chmod 700 "$(dirname "$TMUX_SESSION_FILE")" 2>/dev/null || true
}

state_version() {
    [[ -f "$TMUX_SESSION_FILE" ]] || return 1
    local header
    IFS= read -r header < "$TMUX_SESSION_FILE" || return 1
    [[ "$header" == '# tms-state-version: 3' ]] && printf '3\n' || printf 'legacy\n'
}

save_sessions() {
    require_tmux
    ensure_private_parent
    local tmp count d=$'\t'
    tmp=$(mktemp "${TMUX_SESSION_FILE}.tmp.XXXXXX") || die "cannot create temporary state file"
    trap 'rm -f "$tmp"' RETURN
    chmod 600 "$tmp"
    printf '# tms-state-version: 3\n' > "$tmp"
    # Commands deliberately are not persisted or restarted. list-panes -a exits
    # non-zero when no server exists, which is an empty state rather than an error.
    tmux list-panes -a -F "#S${d}#I${d}#W${d}#P${d}#{pane_current_path}${d}#{window_layout}" >> "$tmp" 2>/dev/null || true
    awk -F '\t' 'NR == 1 { next } NF != 6 { exit 1 }' "$tmp" || die "generated state is invalid"
    mv -f "$tmp" "$TMUX_SESSION_FILE" || die "cannot replace state file"
    chmod 600 "$TMUX_SESSION_FILE" 2>/dev/null || true
    trap - RETURN
    count=$(awk 'NR > 1 { n++ } END { print n + 0 }' "$TMUX_SESSION_FILE")
    printf 'Saved %s pane records to %s\n' "$count" "$TMUX_SESSION_FILE"
}

ensure_window() {
    local session=$1 index=$2 name=$3 dir=$4 existing
    existing=$(window_index_by_name "$session" "$name")
    [[ -n "$existing" ]] && { printf '%s\n' "$existing"; return; }
    if ! has_session "$session"; then
        tmux new-session -d -s "$session" -n "$name" -c "$dir" || return 1
        # A new session begins at tmux's base index (normally 0). Move it when
        # the saved index is available, preserving state ordering where possible.
        tmux move-window -s "$session:$name" -t "$session:$index" 2>/dev/null || true
    elif tmux list-windows -t "$session" -F '#I' | awk -v wanted_index="$index" '$0 == wanted_index { found=1 } END { exit !found }'; then
        tmux new-window -d -t "$session:" -n "$name" -c "$dir" || return 1
    else
        tmux new-window -d -t "$session:$index" -n "$name" -c "$dir" || return 1
    fi
    window_index_by_name "$session" "$name"
}

ensure_panes() {
    local session=$1 window=$2 wanted=$3 dir=$4 count
    count=$(tmux list-panes -t "$session:$window" -F '#{pane_index}' 2>/dev/null | awk 'END { print NR }')
    # `wanted` is the number of panes in the saved window, not a pane index.
    # Pane indexes are commonly zero-based, so comparing the count with #P
    # creates an extra pane for a saved single-pane window (#P == 0).
    while ((count < wanted)); do
        tmux split-window -d -t "$session:$window" -c "$dir" || return 1
        count=$((count + 1))
    done
}

saved_pane_count() {
    awk -F '\t' \
        -v saved_session="$1" \
        -v saved_index="$2" \
        -v saved_window="$3" \
        '$1 == saved_session && $2 == saved_index && $3 == saved_window { count++ }
         END { print count + 0 }' "$TMUX_SESSION_FILE"
}

restore_v3() {
    local session index window pane dir layout actual_window restored=0 skipped=0
    local pane_count
    tmux start-server >/dev/null 2>&1 || true
    while IFS=$'\t' read -r session index window pane dir layout; do
        [[ "$session" == \#* || -z "$session" ]] && continue
        pane_count=$(saved_pane_count "$session" "$index" "$window")
        if [[ ! -d "$dir" ]]; then
            say "skipping $session:$window: directory does not exist: $dir"
            skipped=$((skipped + 1)); continue
        fi
        # Use the index returned by ensure_window for all subsequent tmux
        # commands. A window name can also be parsed as a target index (for
        # example, a window named "0"), causing list-panes to fail and the
        # old count-based code to create unnecessary splits.
        actual_window=$(ensure_window "$session" "$index" "$window" "$dir") || die "cannot create $session:$window"
        [[ -n "$actual_window" ]] || die "cannot find restored window: $session:$window"
        ensure_panes "$session" "$actual_window" "$pane_count" "$dir" || die "cannot create panes for $session:$window"
        # Restore each pane's working directory as well as the window layout.
        tmux select-pane -t "$session:$actual_window.$pane" -c "$dir" >/dev/null 2>&1 || true
        [[ -z "$layout" ]] || tmux select-layout -t "$session:$actual_window" "$layout" >/dev/null 2>&1 || true
        tmux set-option -t "$session" @tms_managed 1 >/dev/null 2>&1 || true
        restored=$((restored + 1))
    done < "$TMUX_SESSION_FILE"
    printf 'Restored %s pane records%s\n' "$restored" "$([[ $skipped -gt 0 ]] && printf ' (some entries were skipped)')"
}

restore_legacy() {
    local session window dir index=0
    say "migrating legacy state format; save again to write version 3"
    tmux start-server >/dev/null 2>&1 || true
    while IFS=$'\t' read -r session window dir; do
        [[ -n "$session" && -n "$window" && -d "$dir" ]] || continue
        ensure_window "$session" "$index" "$window" "$dir" >/dev/null || die "cannot create $session:$window"
        index=$((index + 1))
    done < "$TMUX_SESSION_FILE"
}

restore_sessions() {
    require_tmux
    if [[ ! -s "$TMUX_SESSION_FILE" ]]; then
        printf 'Nothing to restore: %s does not exist or is empty.\n' "$TMUX_SESSION_FILE"; return
    fi
    case $(state_version) in
        3) restore_v3 ;;
        legacy) restore_legacy ;;
        *) die "unsupported state-file version in $TMUX_SESSION_FILE" ;;
    esac
}

forget_session() {
    local session=$1 tmp
    [[ -f "$TMUX_SESSION_FILE" ]] || { printf 'No saved state at %s.\n' "$TMUX_SESSION_FILE"; return; }
    tmp=$(mktemp "${TMUX_SESSION_FILE}.tmp.XXXXXX") || die "cannot create temporary state file"
    trap 'rm -f "$tmp"' RETURN
    awk -F '\t' -v session="$session" 'NR == 1 || $1 != session' "$TMUX_SESSION_FILE" > "$tmp" || die "cannot update state"
    chmod 600 "$tmp" && mv -f "$tmp" "$TMUX_SESSION_FILE" || die "cannot replace state file"
    trap - RETURN
    printf 'Forgot saved session %s.\n' "$session"
}

kill_session() {
    local session=$1
    has_session "$session" || die "session does not exist: $session"
    if [[ $FORCE -ne 1 && -t 0 ]]; then
        printf 'Kill tmux session %s? [y/N] ' "$session" >&2
        local answer; IFS= read -r answer
        [[ "$answer" == y || "$answer" == Y ]] || return
    fi
    tmux kill-session -t "$session"
}

sanitize_session_name() {
    local name=${1##*/}
    name=${name//./_}; name=${name//:/_}; name=${name// /_}
    printf '%s\n' "$name"
}

current_directory_session() {
    # cksum is POSIX and produces a stable numeric identifier without relying
    # on platform-specific md5/md5sum command names.
    local hash
    hash=$(printf '%s' "$PWD" | cksum | awk '{ print substr($1, 1, 8) }')
    printf 'shell-%s\n' "$hash"
}

project_root() {
    local dir=$1 root
    root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && { printf '%s\n' "$root"; return; }
    printf '%s\n' "$dir"
}

resolve_project() {
    local input=$1 entry path depth candidate matches=()
    if [[ -d "$input" ]]; then project_root "$(cd "$input" && pwd)"; return; fi
    for entry in "${TS_SEARCH_PATHS[@]}"; do
        if [[ "$entry" =~ ^(.+):([0-9]+)$ ]]; then path=${BASH_REMATCH[1]}; depth=${BASH_REMATCH[2]}; else path=$entry; depth=$TMS_DEFAULT_SEARCH_DEPTH; fi
        [[ -d "$path" ]] || continue
        [[ -d "$path/$input" ]] && matches+=("$path/$input")
        while IFS= read -r candidate; do [[ "${candidate##*/}" == "$input" ]] && matches+=("$candidate"); done < <(find "$path" -mindepth 1 -maxdepth "$depth" -type d -not -path '*/.git/*' 2>/dev/null)
    done
    (( ${#matches[@]} == 1 )) || { (( ${#matches[@]} == 0 )) && die "project not found: $input" || die "project name is ambiguous: $input"; }
    project_root "${matches[0]}"
}

find_dirs() {
    local entry path depth
    local -a tmux_sessions=()

    # Live tmux sessions first.
    while IFS= read -r session; do
        [[ -n "$session" ]] && tmux_sessions+=("$session")
    done < <(tmux list-sessions -F '#S' 2>/dev/null)

    for ((i=${#tmux_sessions[@]}-1; i>=0; i--)); do
        printf '[TMUX] %s\n' "${tmux_sessions[i]}"
    done

    # Project directories afterwards.
    for entry in "${TS_SEARCH_PATHS[@]}"; do
        if [[ "$entry" =~ ^(.+):([0-9]+)$ ]]; then
            path=${BASH_REMATCH[1]}
            depth=${BASH_REMATCH[2]}
        else
            path=$entry
            depth=$TMS_DEFAULT_SEARCH_DEPTH
        fi

        [[ -d "$path" ]] || continue

        find "$path" \
            -mindepth 1 \
            -maxdepth "$depth" \
            -type d \
            -not -path '*/.git/*' \
            -print 2>/dev/null |
            awk '{ print "[DIR] " $0 }'
    done
}

preview() {
    local selected=${1#\[DIR\] }
    if [[ "$selected" == '[TMUX] '* ]]; then tmux list-windows -t "${selected#\[TMUX\] }" -F '#{window_index}: #{window_name}  #{pane_current_path}' 2>/dev/null; return; fi
    printf '%s\n\n' "$selected"
    if git -C "$selected" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf 'Git: %s\n' "$(git -C "$selected" branch --show-current 2>/dev/null)"
        git -C "$selected" status --short 2>/dev/null | head -20
    fi
}

select_project() {
    require fzf

    local args=( --border --no-scrollbar --no-mouse --pointer='> ' --no-info --prompt='tms> ' --marker=' ' --preview "$0 --preview {}")

    if (( FULLSCREEN_FZF )); then
        args+=(--no-height)
    else
        args+=(--height=40%)
    fi

    find_dirs | fzf "${args[@]}" || true
}

ensure_session() {
    local session=$1 dir=$2
    if ! has_session "$session"; then
        tmux new-session -d -s "$session" -c "$dir" || die "cannot create session $session"
        tmux set-option -t "$session" @tms_managed 1 >/dev/null 2>&1 || true
        apply_project_config "$session" "$dir"
    fi
}

tms_window() {
    local name=$1 dir=${2:-$PROJECT_ROOT}
    has_window "$TMS_SESSION" "$name" || tmux new-window -d -t "$TMS_SESSION:" -n "$name" -c "$dir"
}

tms_pane() {
    local window=$1 command=$2 direction=${3:-vertical} size=${4:-}
    has_window "$TMS_SESSION" "$window" || die "project config refers to missing window: $window"
    local args=(-d -t "$TMS_SESSION:$window" -c "$PROJECT_ROOT")
    [[ "$direction" == horizontal ]] && args+=(-h) || args+=(-v)
    [[ -n "$size" ]] && args+=(-p "$size")
    tmux split-window "${args[@]}" "$command"
}

apply_project_config() {
    local session=$1 root=$2 config
    config="$root/.tmux-sessionizer"
    [[ -f "$config" ]] || return
    [[ "${TMS_TRUST_PROJECT_CONFIG:-0}" == 1 ]] || { say "not loading $config (set TMS_TRUST_PROJECT_CONFIG=1 to opt in)"; return; }
    TMS_SESSION=$session PROJECT_ROOT=$root source "$config"
}

prepare_session() {
    local session root skip_project_config=${3:-0}
    if (( $# >= 2 )); then
        session=$1
        root=$2
    else
        [[ -n "${TMUX:-}" ]] || die "prepare needs an active tmux session"
        session=$(tmux display-message -p '#S')
        root=$(tmux display-message -p -t "$session" '#{pane_current_path}')
    fi
    TMS_SESSION=$session PROJECT_ROOT=$root
    local window
    for window in "${TMS_WINDOWS[@]}"; do tms_window "$window" "$root"; done
    (( skip_project_config == 1 )) || apply_project_config "$session" "$root"
    [[ -n "${TMS_GIT_STARTUP:-}" ]] && has_window "$session" git && tmux send-keys -t "$session:git" "$TMS_GIT_STARTUP" C-m
    tmux select-window -t "$session:${TMS_WINDOWS[0]}" 2>/dev/null || true
    printf 'Prepared tmux session %s.\n' "$session"
}

switch_to() { [[ -n "${TMUX:-}" ]] && tmux switch-client -t "$1" || tmux attach-session -t "$1"; }

show_help() {
    cat <<'EOF'
Usage: tms [open] [PROJECT]
       tms COMMAND [ARGUMENT] [OPTIONS]

Open a project directly, or run tms with no arguments to choose one with FZF.
A project may be a directory or an unambiguous name in TS_SEARCH_PATHS. Use
`.` or `new` for a deterministic shell-<directory-hash> session.

Commands:
  open [PROJECT]          Open/create a project session (the default)
  create NAME             Create/attach NAME in the current directory
  new                     Create/attach shell-<8-digit-directory-hash>
  list                    List live tmux sessions
  save                    Atomically save windows, panes, indexes, and layouts
  restore                 Idempotently reconcile saved state
  state                   Print saved state
  forget NAME             Remove NAME from saved state; leave it live
  kill NAME               Kill a live session (asks for confirmation on a TTY)
  prepare                 Apply the configured layout to the current tmux session

Options:
  -f, --full              Use a full-screen FZF picker
      --force             Do not ask before kill
      --debug             Emit diagnostics to stderr
  -h, --help              Show this help

Compatibility aliases: --create/-c, --new/-n, --ls/-l, --save/-s,
--restore/-r, --get/-g, --forget/--remove/-x, --kill/-k, and --prepare/-p.

Examples:
  tms                     Choose a project or live session
  tms open api            Open project named api (or create session api)
  tms .                   Create/attach the current directory's shell-<hash> session
  tms new                 Create/attach a deterministic shell-<hash> session
  tms kill api --force    Kill api without a prompt
  tms save && tms restore Save and later reconcile state

EOF
    [[ -f "$TMS_CONFIG_FILE" ]] && printf 'User config: %s\n' "$TMS_CONFIG_FILE"
    printf 'State file: %s\n' "$TMUX_SESSION_FILE"
}

main() {
    load_config
    local action=open selected session dir command_seen=0
    while (( $# )); do
        case $1 in
            -h|--help|help) show_help; return ;;
            -f|--full) FULLSCREEN_FZF=1 ;;
            --debug) TMS_DEBUG=1 ;;
            --force) FORCE=1 ;;
            --preview) shift; preview "${1:-}"; return ;;
            open) [[ $command_seen -eq 0 ]] || die "only one command may be supplied"; command_seen=1; action=open ;;
            new|-n|--new) [[ $command_seen -eq 0 ]] || die "only one command may be supplied"; command_seen=1; action=direct; session=$(current_directory_session); dir=$(pwd) ;;
            list|-l|--ls) action=list; command_seen=1 ;;
            save|-s|--save) action=save; command_seen=1 ;;
            restore|-r|--restore) action=restore; command_seen=1 ;;
            state|get|-g|--get) action=get; command_seen=1 ;;
            prepare|-p|--prepare) action=prepare; command_seen=1 ;;
            create|-c|--create) shift; [[ $# -gt 0 ]] || die "create requires NAME"; session=$1; dir=$(pwd); action=direct; command_seen=1 ;;
            kill|-k|--kill) shift; [[ $# -gt 0 ]] || die "kill requires NAME"; PROJECT_ARGUMENT=$1; action=kill; command_seen=1 ;;
            forget|remove|-x|--remove|--forget) shift; [[ $# -gt 0 ]] || die "forget requires NAME"; PROJECT_ARGUMENT=$1; action=forget; command_seen=1 ;;
            --) shift; [[ $# -le 1 ]] || die "only one project may be supplied"; PROJECT_ARGUMENT=${1:-}; break ;;
            .) [[ $action == open && -z "$PROJECT_ARGUMENT" ]] || die "unexpected argument: ."; command_seen=1; action=direct; session=$(current_directory_session); dir=$(pwd) ;;
            -*) die "unknown option: $1 (run 'tms help')" ;;
            *)
                [[ $action == open && -z "$PROJECT_ARGUMENT" ]] || die "unexpected argument: $1"
                PROJECT_ARGUMENT=$1
                ;;
        esac
        shift
    done
    case $action in
        save) save_sessions; return ;;
        restore) restore_sessions; return ;;
        get) [[ -f "$TMUX_SESSION_FILE" ]] && cat "$TMUX_SESSION_FILE" || printf 'No saved state at %s.\n' "$TMUX_SESSION_FILE"; return ;;
        list) require_tmux; tmux list-sessions -F '#{session_name}' 2>/dev/null || true; return ;;
        forget) forget_session "$PROJECT_ARGUMENT"; return ;;
        kill) require_tmux; kill_session "$PROJECT_ARGUMENT"; return ;;
        prepare)
            require_tmux
            if [[ -n "${TMUX:-}" ]]; then
                prepare_session
            else
                dir=$(pwd)
                session=$(current_directory_session)
                ensure_session "$session" "$dir"
                # ensure_session already applies config for a newly created session.
                prepare_session "$session" "$dir" 1
                switch_to "$session"
            fi
            return ;;
    esac
    require_tmux
    if [[ $action == direct ]]; then ensure_session "$session" "$dir"; switch_to "$session"; return; fi
    if [[ -n "$PROJECT_ARGUMENT" ]]; then
        # A positional name first resolves as a project. If it is not a known
        # project, treat it as a direct session name in the current directory.
        if dir=$(resolve_project "$PROJECT_ARGUMENT" 2>/dev/null); then
            session=$(sanitize_session_name "$dir")
        else
            session=$PROJECT_ARGUMENT
            dir=$(pwd)
        fi
    else
        selected=$(select_project)
        [[ -n "$selected" ]] || return
        if [[ "$selected" == '[TMUX] '* ]]; then switch_to "${selected#\[TMUX\] }"; return; fi
        dir=${selected#\[DIR\] }
    fi
    [[ -n "${session:-}" ]] || session=$(sanitize_session_name "$dir")
    log "project=$dir session=$session"
    ensure_session "$session" "$dir"; switch_to "$session"
}

main "$@"
